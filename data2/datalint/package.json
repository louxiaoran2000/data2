{
  "name": "datalint",
  "version": "0.1.0",
  "description": "JSONL 数据质检与统计命令行工具",
  "type": "module",
  "private": true,
  "bin": {
    "datalint": "bin/datalint.js"
  },
  "scripts": {
    "start": "node bin/datalint.js",
    "example": "node bin/datalint.js examples/users.jsonl",
    "example:json": "node bin/datalint.js --format json examples/users.jsonl",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
